# Frontend environment variables
# Copy to .env (or .env.local) and fill in from Supabase → Project Settings → API.
#
# Use the anon PUBLIC key only. Never expose a service-role key in a Vite app.
# The app runs in "setup preview" mode without these values, but online
# multiplayer is only available when both are present.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY


